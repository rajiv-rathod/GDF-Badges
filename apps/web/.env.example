# --- Supabase (create a free project at https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — Settings → API → service_role key. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Credential signing (run: node scripts/generate-signing-keys.mjs) ---
CREDENTIAL_SIGNING_KEY=
NEXT_PUBLIC_CREDENTIAL_PUBLIC_KEY=

# --- Jitsi meetings (optional — your self-hosted instance) ---
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_JWT_SECRET=

# --- Email notifications via Resend (optional — no key = no emails, nothing breaks) ---
RESEND_API_KEY=
# EMAIL_FROM="MUN CertView <credentials@yourdomain.org>"

# --- Gemini AI (optional — features stay hidden without a key) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# FEATURE_AI=false   # force-disable even when a key is set
