# --- Supabase ---
# The app accepts EITHER Next-style names OR Supabase's default names, so if
# you connected Supabase to Vercel (which injects SUPABASE_URL /
# SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY) you don't need to add anything.
NEXT_PUBLIC_SUPABASE_URL=            # or SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # or SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=           # or SUPABASE_SECRET_KEY  (server only — never public)

# --- Credential signing (OPTIONAL) ---
# If unset, the server auto-generates an Ed25519 key on first use and stores it
# in the app_config table. Set this for stronger security (a DB compromise
# alone then can't forge signatures). Generate with:
#   node scripts/generate-signing-keys.mjs   (use only the CREDENTIAL_SIGNING_KEY line)
CREDENTIAL_SIGNING_KEY=

# --- Email notifications via Resend (optional — no key = no emails, nothing breaks) ---
RESEND_API_KEY=
# EMAIL_FROM="MUN CertView <credentials@yourdomain.org>"

# --- Gemini AI (optional — features stay hidden without a key) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# FEATURE_AI=false   # force-disable even when a key is set
